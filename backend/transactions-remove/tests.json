{
  "tests": [
    {
      "name": "Missing company_id returns 400",
      "method": "POST",
      "path": "/",
      "body": {"items": [{"type": "payment", "id": 1}]},
      "expectedStatus": 400,
      "expectedBody": {"error": "string"},
      "bodyMatcher": "partial"
    },
    {
      "name": "Empty items returns 400",
      "method": "POST",
      "path": "/",
      "body": {"company_id": 1, "items": []},
      "expectedStatus": 400,
      "expectedBody": {"error": "string"},
      "bodyMatcher": "partial"
    },
    {
      "name": "Invalid type returns 400",
      "method": "POST",
      "path": "/",
      "body": {"company_id": 1, "items": [{"type": "bogus", "id": 1}]},
      "expectedStatus": 400,
      "expectedBody": {"error": "string"},
      "bodyMatcher": "partial"
    },
    {
      "name": "Non-existent id is skipped, not an error",
      "method": "POST",
      "path": "/",
      "body": {"company_id": 999999, "items": [{"type": "payment", "id": 999999}]},
      "expectedStatus": 200,
      "expectedBody": {"success": true, "removed_count": 0},
      "bodyMatcher": "partial"
    }
  ]
}
