{
  "tests": [
    {
      "name": "Missing company_id returns 400",
      "method": "POST",
      "path": "/",
      "body": {"date_from": "2026-01-01T00:00:00Z", "date_to": "2026-01-02T00:00:00Z"},
      "expectedStatus": 400,
      "expectedBody": {"error": "string"},
      "bodyMatcher": "partial"
    },
    {
      "name": "Missing dates returns 400",
      "method": "POST",
      "path": "/",
      "body": {"company_id": 1},
      "expectedStatus": 400,
      "expectedBody": {"error": "string"},
      "bodyMatcher": "partial"
    },
    {
      "name": "No active ecomkassa integration returns 404",
      "method": "POST",
      "path": "/",
      "body": {"company_id": 999999, "date_from": "2026-01-01T00:00:00Z", "date_to": "2026-01-02T00:00:00Z"},
      "expectedStatus": 404,
      "expectedBody": {"error": "string"},
      "bodyMatcher": "partial"
    }
  ]
}
