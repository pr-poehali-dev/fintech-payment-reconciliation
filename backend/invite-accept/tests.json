{
  "tests": [
    {
      "name": "GET missing token",
      "method": "GET",
      "path": "/",
      "expectedStatus": 400,
      "expectedBody": {
        "error": "string"
      },
      "bodyMatcher": "partial"
    },
    {
      "name": "GET invite not found",
      "method": "GET",
      "path": "/?token=nonexistent_token_123",
      "expectedStatus": 404,
      "expectedBody": {
        "error": "string"
      },
      "bodyMatcher": "partial"
    },
    {
      "name": "Без входа доступ закрыт",
      "method": "POST",
      "path": "/",
      "expectedStatus": 401,
      "expectedBody": {
        "error_code": "session_required"
      },
      "bodyMatcher": "partial",
      "body": {
        "token": "x",
        "user_id": 1,
        "phone": "79990000001"
      }
    },
    {
      "name": "Чужая/поддельная сессия не принимается",
      "method": "POST",
      "path": "/",
      "headers": {
        "X-Session-Id": "fake-session-token"
      },
      "expectedStatus": 401,
      "expectedBody": {
        "error_code": "session_required"
      },
      "bodyMatcher": "partial",
      "body": {
        "token": "x",
        "user_id": 1,
        "phone": "79990000001"
      }
    }
  ]
}