{
  "tests": [
    {
      "name": "Receive Tbank webhook",
      "method": "POST",
      "path": "/?token=test_token_12345",
      "body": {
        "TerminalKey": "1234567890",
        "OrderId": "ORDER-123",
        "Success": true,
        "Status": "CONFIRMED",
        "PaymentId": "12345678",
        "ErrorCode": "0",
        "Amount": 25000,
        "Pan": "430000******0777",
        "Token": "test_signature"
      },
      "expectedStatus": 404,
      "bodyMatcher": "partial"
    },
    {
      "name": "Receive Ecomkassa direct fiscal callback (ATOL v5 format)",
      "method": "POST",
      "path": "/?token=test_token_12345",
      "body": {
        "uuid": "2ea26f17-0884-4f08-b120-306fc096a58f",
        "error": null,
        "status": "done",
        "payload": {
          "total": 1598,
          "fiscal_receipt_number": 6,
          "receipt_datetime": "12.04.2022 20:16:00"
        },
        "external_id": "TRF10601_1"
      },
      "expectedStatus": 404,
      "bodyMatcher": "partial"
    },
    {
      "name": "Missing token",
      "method": "POST",
      "body": {},
      "expectedStatus": 400,
      "expectedBody": {
        "error": "Token required"
      },
      "bodyMatcher": "partial"
    },
    {
      "name": "Alfa-Bank GET callback with unknown token",
      "method": "GET",
      "path": "/?token=unknown-token&mdOrder=3ff6962a-7dcc-4283-ab50-a6d7dd3386fe&orderNumber=10747&operation=deposited&status=1",
      "expectedStatus": 404,
      "expectedBody": {
        "error": "string"
      },
      "bodyMatcher": "partial"
    },
    {
      "name": "Общий вебхук Точки с неверной подписью не обрабатывается",
      "method": "POST",
      "path": "/?source=tochka",
      "headers": {
        "Content-Type": "text/plain"
      },
      "body": "eyJhbGciOiJSUzI1NiJ9.e30.AAAA",
      "expectedStatus": 200,
      "expectedBody": {
        "ok": true
      },
      "bodyMatcher": "partial"
    }
  ]
}