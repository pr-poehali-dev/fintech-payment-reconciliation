{
  "tests": [
    {
      "name": "Missing company_id returns 400",
      "method": "GET",
      "path": "/",
      "expectedStatus": 400,
      "expectedBody": {
        "error": "string"
      },
      "bodyMatcher": "partial"
    },
    {
      "name": "List transactions for company",
      "method": "GET",
      "path": "/?company_id=1",
      "expectedStatus": 200,
      "expectedBody": {
        "success": true
      },
      "bodyMatcher": "partial"
    },
    {
      "name": "Filter by type=payment",
      "method": "GET",
      "path": "/?company_id=1&type=payment",
      "expectedStatus": 200,
      "expectedBody": {
        "success": true
      },
      "bodyMatcher": "partial"
    },
    {
      "name": "Filter by type=receipt_ofd",
      "method": "GET",
      "path": "/?company_id=1&type=receipt_ofd",
      "expectedStatus": 200,
      "expectedBody": {
        "success": true
      },
      "bodyMatcher": "partial"
    },
    {
      "name": "Filter by type=receipt_kassa",
      "method": "GET",
      "path": "/?company_id=1&type=receipt_kassa",
      "expectedStatus": 200,
      "expectedBody": {
        "success": true
      },
      "bodyMatcher": "partial"
    },
    {
      "name": "Paged registry with filters",
      "method": "GET",
      "path": "/?company_id=1&paged=1&limit=50&offset=0&date_from=2026-09-01&date_to=2026-09-30&unmatched_only=1&search=10",
      "expectedStatus": 200,
      "expectedBody": {
        "success": true,
        "has_more": false
      },
      "bodyMatcher": "partial"
    }
