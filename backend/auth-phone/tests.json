{
  "tests": [
    {
      "name": "Login with valid phone",
      "method": "POST",
      "path": "/",
      "body": {
        "phone": "+79997654321",
        "full_name": "Тест Тестов"
      },
      "expectedStatus": 200,
      "expectedBody": {
        "success": true,
        "user_id": "number"
      },
      "bodyMatcher": "partial"
    },
    {
      "name": "Invalid phone",
      "method": "POST",
      "path": "/",
      "body": {
        "phone": "123"
      },
      "expectedStatus": 400,
      "expectedBody": {
        "error": "string"
      },
      "bodyMatcher": "partial"
    }
  ]
}