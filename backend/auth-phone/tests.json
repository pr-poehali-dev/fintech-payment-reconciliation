{
  "tests": [
    {
      "name": "Invalid phone",
      "method": "POST",
      "path": "/",
      "body": {
        "action": "send",
        "phone": "123"
      },
      "expectedStatus": 400,
      "expectedBody": {
        "error": "string"
      },
      "bodyMatcher": "partial"
    },
    {
      "name": "Verify without code",
      "method": "POST",
      "path": "/",
      "body": {
        "action": "verify",
        "phone": "+79997654321"
      },
      "expectedStatus": 400,
      "expectedBody": {
        "error": "string"
      },
      "bodyMatcher": "partial"
    },
    {
      "name": "Verify wrong code without request",
      "method": "POST",
      "path": "/",
      "body": {
        "action": "verify",
        "phone": "+79990000001",
        "code": "000000"
      },
      "expectedStatus": 400,
      "expectedBody": {
        "error_code": "code_expired"
      },
      "bodyMatcher": "partial"
    },
    {
      "name": "Unknown messenger",
      "method": "POST",
      "path": "/",
      "body": {
        "action": "send",
        "phone": "+79990000001",
        "channel": "icq"
      },
      "expectedStatus": 400,
      "expectedBody": {
        "error": "string"
      },
      "bodyMatcher": "partial"
    }
  ]
}