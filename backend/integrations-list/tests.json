{
  "tests": [
    {
      "name": "Без входа доступ закрыт",
      "method": "GET",
      "path": "/?company_id=1",
      "expectedStatus": 401,
      "expectedBody": {
        "error_code": "session_required"
      },
      "bodyMatcher": "partial"
    },
    {
      "name": "Чужая/поддельная сессия не принимается",
      "method": "GET",
      "path": "/?company_id=1",
      "headers": {
        "X-Session-Id": "fake-session-token"
      },
      "expectedStatus": 401,
      "expectedBody": {
        "error_code": "session_required"
      },
      "bodyMatcher": "partial"
    }
  ]
}