{
  "tests": [
    {
      "name": "Без входа доступ закрыт",
      "method": "PUT",
      "path": "/",
      "body": {
        "integration_id": 12,
        "company_id": 1,
        "integration_name": "Updated name",
        "config": {
          "terminal_id": "123",
          "terminal_password": "pass"
        }
      },
      "expectedStatus": 401,
      "expectedBody": {
        "error_code": "session_required"
      },
      "bodyMatcher": "partial"
    },
    {
      "name": "Чужая/поддельная сессия не принимается",
      "method": "PUT",
      "path": "/",
      "headers": {
        "X-Session-Id": "fake-session-token"
      },
      "body": {
        "integration_id": 12,
        "company_id": 1,
        "integration_name": "Updated name",
        "config": {
          "terminal_id": "123",
          "terminal_password": "pass"
        }
      },
      "expectedStatus": 401,
      "expectedBody": {
        "error_code": "session_required"
      },
      "bodyMatcher": "partial"
    }
  ]
}