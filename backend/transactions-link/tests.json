{
  "tests": [
    {
      "name": "Без входа доступ закрыт",
      "method": "POST",
      "path": "/",
      "body": {
        "items": [
          {
            "type": "payment",
            "source": "tbank",
            "id": 1
          },
          {
            "type": "receipt_kassa",
            "source": "ecomkassa",
            "id": 2
          }
        ]
      },
      "expectedStatus": 401,
      "expectedBody": {
        "error_code": "session_required"
      },
      "bodyMatcher": "partial"
    },
    {
      "name": "Чужая/поддельная сессия не принимается",
      "method": "POST",
      "path": "/",
      "headers": {
        "X-Session-Id": "fake-session-token"
      },
      "body": {
        "items": [
          {
            "type": "payment",
            "source": "tbank",
            "id": 1
          },
          {
            "type": "receipt_kassa",
            "source": "ecomkassa",
            "id": 2
          }
        ]
      },
      "expectedStatus": 401,
      "expectedBody": {
        "error_code": "session_required"
      },
      "bodyMatcher": "partial"
    }
  ]
}