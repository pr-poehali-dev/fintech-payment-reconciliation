{
  "tests": [
    {
      "name": "Missing integration_id and company_id",
      "method": "POST",
      "body": {
        "date_from": "2025-01-01T00:00:00",
        "date_to": "2025-01-02T00:00:00"
      },
      "expectedStatus": 400,
      "expectedBody": {
        "error": "integration_id or company_id required"
      }
    },
    {
      "name": "Auto-sync by company_id with no OFD integrations",
      "method": "POST",
      "body": {
        "company_id": 999999
      },
      "expectedStatus": 200,
      "expectedBody": {
        "success": true,
        "integrations_checked": 0
      },
      "bodyMatcher": "partial"
    },
    {
      "name": "GET request returns error",
      "method": "GET",
      "expectedStatus": 200,
      "expectedBody": {
        "error": true,
        "message": "Запрос с заданными параметрами не поддерживается"
      }
    }
  ]
}