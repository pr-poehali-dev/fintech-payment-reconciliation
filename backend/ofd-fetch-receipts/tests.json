{
  "tests": [
    {
      "name": "Без входа доступ закрыт",
      "method": "POST",
      "path": "/",
      "body": {
        "date_from": "2025-01-01T00:00:00",
        "date_to": "2025-01-02T00:00:00"
      },
      "expectedStatus": 401,
      "expectedBody": {
        "error_code": "session_required"
      },
      "bodyMatcher": "partial"
    },
    {
      "name": "Чужая/поддельная сессия не принимается",
      "method": "POST",
      "path": "/",
      "headers": {
        "X-Session-Id": "fake-session-token"
      },
      "body": {
        "date_from": "2025-01-01T00:00:00",
        "date_to": "2025-01-02T00:00:00"
      },
      "expectedStatus": 401,
      "expectedBody": {
        "error_code": "session_required"
      },
      "bodyMatcher": "partial"
    }
  ]
}